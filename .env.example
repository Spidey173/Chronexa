# Chronexa Configuration

# Environment & Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Persistence (SQLite for local/test, PostgreSQL for production)
# SQLite:
DATABASE_URL=sqlite:///./chronexa.db
# PostgreSQL:
# DATABASE_URL=postgresql://chronexa_user:chronexa_password@localhost:5432/chronexa_db

# JWT Authentication & RBAC
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Integration Adapter Mode ("mock" for test/dry-run, "live" for actual API calls)
INTEGRATION_MODE=mock
CHRONEXA_OFFLINE=0

# LLM Providers (Groq recommended for speed, or OpenAI/Anthropic/Gemini)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-flash-latest

# Integration Credentials (optional env fallbacks when per-user OAuth tokens are not set)
# SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# GMAIL_CREDENTIALS={"installed":{...}}
# CALENDAR_CREDENTIALS={"installed":{...}}
